# All optional. Set them in Vercel → Project → Settings → Environment Variables.

# Hosts the server is allowed to fetch (protects the API from being used as an open proxy)
ALLOWED_HOSTS=www.kingsresearch.com,kingsresearch.com

# User agent for page/sitemap requests
# FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36 KingsResearchTranslationQA/2.0

# Extra request headers as JSON, e.g. a secret header your WAF/Cloudflare rule lets through
# FETCH_EXTRA_HEADERS={"x-qa-token":"change-me"}

# Password-protect the whole app (browser login prompt)
# BASIC_AUTH_USER=qa
# BASIC_AUTH_PASS=change-me
